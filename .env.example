# ---------------------------------------------------------------------------
# WishBridge environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Public (sent to the browser). Safe to expose: access is enforced by RLS.
# Local values are printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or the legacy "anon" JWT key

# Canonical site URL, used in auth emails and redirects (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used solely to record payment
# outcomes (record_contribution_result) from trusted server code.
SUPABASE_SECRET_KEY=sb_secret_xxx   # or the legacy "service_role" JWT key

# Payments. Only "simulated" exists in the MVP; it never moves money.
PAYMENT_PROVIDER=simulated

# Optional: database URL used by the SQL-level test suite only.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
